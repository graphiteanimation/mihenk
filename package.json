{
 "name": "atolyecad",
 "version": "0.1.0",
 "description": "Parametrik CAD",
 "main": "electron/main.cjs",
 "scripts": {
  "dev": "vite",
  "build": "vite build",
  "dist": "vite build && electron-builder --win dir --x64 && cd build && NSISDIR=$HOME/.cache/electron-builder/nsis-3.0.4.1/nsis-3.0.4.1-1mx3n && $NSISDIR/linux/makensis -V2 installer.nsi",
  "preview": "vite preview",
  "test": "node test/kernel.test.mjs && node test/solver.test.mjs",
  "electron": "electron ."
 },
 "keywords": [],
 "author": "Osman",
 "license": "ISC",
 "dependencies": {
  "@salusoft89/planegcs": "^1.3.0",
  "replicad": "^1.2.1",
  "replicad-opencascadejs": "^1.2.1",
  "three": "^0.187.0"
 },
 "devDependencies": {
  "electron": "^45.2.3",
  "electron-builder": "^26.18.0",
  "playwright": "^1.65.0",
  "vite": "^8.3.7"
 },
 "productName": "AtolyeCAD",
 "build": {
  "appId": "com.d160.atolyecad",
  "productName": "AtolyeCAD",
  "files": [
   "dist/**",
   "electron/**",
   "package.json"
  ],
  "directories": {
   "output": "release"
  },
  "win": {
   "target": [
    {
     "target": "dir",
     "arch": [
      "x64"
     ]
    }
   ],
   "signAndEditExecutable": false
  }
 },
 "type": "module"
}